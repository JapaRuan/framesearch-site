PORT=3000

# Chave para liberar GET /api/leads/export.csv (defina algo forte em produção).
# Sem essa variável, o endpoint de export fica bloqueado por padrão.
ADMIN_EXPORT_KEY=

# Credencial do Admin SDK do Firebase (service account) usada para gravar os
# leads no Firestore. Em produção (Render), o valor é o conteúdo INTEIRO do
# JSON da service account, colado como uma única linha (sem quebra de linha).
# Em desenvolvimento local, não é obrigatório definir isso: o código cai para
# o arquivo server/firebase-service-account.json se ele existir (nunca
# commitado, está no .gitignore). Se nem a variável nem o arquivo existirem,
# o servidor roda em modo local (JSON Lines em server/data/leads.jsonl) e
# avisa no console que não tem persistência real.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# Só necessário se o disco de leads locais (modo fallback sem Firebase) não
# puder ficar em server/data (ex.: apontar para um disco persistente do
# Render em produção).
# LEADS_DB_DIR=/var/data/framesearch
